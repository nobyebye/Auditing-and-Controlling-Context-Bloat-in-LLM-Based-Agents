{
  "schema_version": "1.2.0",
  "rule_version": "rq-rules-v2.0.0",
  "rq1": {
    "minimum_macro_f1": 0.7,
    "minimum_localization_accuracy": 0.7,
    "reference_requirement": "adjudicated_human_labels"
  },
  "rq2": {
    "minimum_spearman_rho": 0.7,
    "reference_requirement": "adjudicated_human_labels",
    "secondary_metrics": [
      "mean_absolute_error",
      "calibration",
      "bland_altman"
    ]
  },
  "rq3": {
    "interpretation": "descriptive_within_study_only"
  },
  "rq4": {
    "minimum_token_reduction": 0.0,
    "noninferiority_margin": -0.05,
    "margin_interpretation": "at most one additional failure per twenty tasks",
    "sensitivity_margins": [
      -0.02,
      -0.05,
      -0.1
    ]
  }
}
