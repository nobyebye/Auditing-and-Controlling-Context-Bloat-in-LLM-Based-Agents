{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-auditor.local/schemas/external-validation-1.2.0.json",
  "title": "External Validation Experiment",
  "type": "object",
  "required": [
    "schema_version",
    "experiment_id",
    "dataset_name",
    "dataset_version",
    "framework",
    "provider",
    "model"
  ],
  "properties": {
    "schema_version": {"const": "1.2.0"},
    "experiment_id": {"type": "string", "minLength": 1},
    "dataset_name": {"const": "external_validation"},
    "dataset_version": {"const": "v1"},
    "dataset_split": {"enum": ["calibration", "test"]},
    "framework": {"enum": ["langchain", "custom-react"]},
    "provider": {"enum": ["mock", "deepseek"]},
    "model": {"type": "string", "minLength": 1},
    "call_budget": {"type": "integer", "minimum": 1, "maximum": 500},
    "max_tool_invocations": {"type": "integer", "minimum": 1, "maximum": 2},
    "privacy_mode": {"enum": ["redacted", "hash-only", "full"]}
  },
  "additionalProperties": true
}
