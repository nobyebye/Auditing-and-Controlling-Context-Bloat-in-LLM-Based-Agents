{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/context-auditor/experiment.schema.json",
  "title": "Context Auditor Experiment Configuration",
  "type": "object",
  "required": [
    "schema_version",
    "experiment_id",
    "dataset_name",
    "dataset_version",
    "framework",
    "provider",
    "model",
    "workflows"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "experiment_id": {"type": "string", "pattern": "^[a-z0-9._-]+$"},
    "dataset_name": {"type": "string", "pattern": "^[a-z0-9._-]+$"},
    "dataset_version": {"type": "string", "pattern": "^v[0-9]+$"},
    "framework": {"enum": ["custom-react", "langchain"]},
    "provider": {"enum": ["mock", "deepseek"]},
    "model": {"type": "string"},
    "repetitions": {"type": "integer", "minimum": 1},
    "seed": {"type": "integer"},
    "privacy_mode": {"enum": ["redacted", "full", "hash-only"]},
    "workflows": {"type": "object", "minProperties": 1}
  },
  "additionalProperties": false
}
