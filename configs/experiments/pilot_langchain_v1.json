{
  "schema_version": "1.1.0",
  "experiment_id": "pilot-context-bloat-langchain-v1",
  "dataset_name": "controlled_synthetic",
  "dataset_version": "v1",
  "framework": "langchain",
  "provider": "mock",
  "model": "mock-llm",
  "repetitions": 1,
  "seed": 42,
  "privacy_mode": "redacted",
  "workflows": {
    "retrieval_qa": [
      {"name": "baseline"},
      {"name": "retrieval_top1", "retrieval_top_k": 1},
      {"name": "retrieval_top3", "retrieval_top_k": 3},
      {"name": "retrieval_duplicate", "retrieval_top_k": 2, "duplicate_retrieval": true},
      {"name": "retrieval_duplicate_mitigated", "retrieval_top_k": 2, "duplicate_retrieval": true, "mitigation_strategy": "exact_duplicate_removal"},
      {"name": "retrieval_irrelevant", "retrieval_top_k": 2, "include_irrelevant_retrieval": true},
      {"name": "retrieval_irrelevant_mitigated", "retrieval_top_k": 2, "include_irrelevant_retrieval": true, "mitigation_strategy": "irrelevant_context_filter"}
    ],
    "memory_turns": [
      {"name": "baseline"},
      {"name": "memory_full", "include_memory": true},
      {"name": "memory_duplicate", "include_memory": true, "duplicate_memory": true},
      {"name": "memory_duplicate_mitigated", "include_memory": true, "duplicate_memory": true, "mitigation_strategy": "exact_duplicate_removal"}
    ],
    "multi_step_tool": [
      {"name": "baseline"},
      {"name": "tool_use", "use_tools": true},
      {"name": "tool_repeated_output", "use_tools": true, "repeat_tool_output": true},
      {"name": "tool_repeated_output_mitigated", "use_tools": true, "repeat_tool_output": true, "mitigation_strategy": "exact_duplicate_removal"},
      {"name": "retrieval_memory_tool", "retrieval_top_k": 3, "include_memory": true, "use_tools": true}
    ]
  }
}
